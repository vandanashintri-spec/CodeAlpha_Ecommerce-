# Local development defaults. Set real values in the hosting provider's secret manager.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TRUST_PROXY_SSL_HEADER=false

# Leave blank for local SQLite. In production, use the PostgreSQL URL provided by your host.
DATABASE_URL=

# SMTP is optional locally (the console backend is used). Configure for production email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ByteCart <no-reply@example.com>
